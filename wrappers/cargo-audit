#!/data/data/com.termux/files/usr/bin/bash
# cargo-audit wrapper for Termux: uses git to fetch the advisory DB since
# rustls-platform-verifier requires Android JVM init (unavailable in Termux).

if [ -t 2 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != "dumb" ]; then
    _B='\033[1m' _G='\033[92m' _Y='\033[33m' _R='\033[31m' _0='\033[0m'
else
    _B='' _G='' _Y='' _R='' _0=''
fi
status() { printf "${_B}${_G}%12s${_0} %s\n" "$1" "$2"; }
warn()   { printf "${_B}${_Y}warning${_0}: %s\n" "$1" >&2; }
err()    { printf "${_B}${_R}error${_0}: %s\n" "$1" >&2; }

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ADVISORY_DB_DIR="${CARGO_AUDIT_DB:-${HOME}/.cargo/advisory-db}"
ADVISORY_DB_REPO="https://github.com/RustSec/advisory-db.git"

# Prefer cargo-install'd real binary, fall back to pkg-installed system binary.
if [ -f "$SCRIPT_DIR/cargo-audit-real" ] && [ -x "$SCRIPT_DIR/cargo-audit-real" ]; then
    REAL_BIN="$SCRIPT_DIR/cargo-audit-real"
elif [ -f "$PREFIX/bin/cargo-audit" ] && [ -x "$PREFIX/bin/cargo-audit" ]; then
    REAL_BIN="$PREFIX/bin/cargo-audit"
else
    err "cargo-audit binary not found."
    exit 1
fi

# Pass through if not the audit subcommand, or if user already controls fetch behavior.
[ "${1:-}" != "audit" ] && exec "$REAL_BIN" "$@"
for arg in "$@"; do
    case "$arg" in --no-fetch|--db|-n) exec "$REAL_BIN" "$@" ;; esac
done

# Sync advisory DB via git, at most once per 24 hours.
PULL_STAMP="${ADVISORY_DB_DIR}/.last_pull"
NOW=$(date +%s)
LAST_PULL=0
[ -f "$PULL_STAMP" ] && LAST_PULL=$(cat "$PULL_STAMP" 2>/dev/null || echo 0)

if [ -d "$ADVISORY_DB_DIR/.git" ]; then
    if [ $(( NOW - LAST_PULL )) -ge 86400 ]; then
        status "Updating" "advisory database"
        if git -C "$ADVISORY_DB_DIR" pull --ff-only -q 2>&1; then
            echo "$NOW" > "$PULL_STAMP"
        else
            warn "git pull failed, using cached DB."
        fi
    fi
else
    status "Cloning" "advisory DB (first run)"
    git clone --depth=1 -q "$ADVISORY_DB_REPO" "$ADVISORY_DB_DIR" || {
        err "failed to clone advisory DB."
        exit 1
    }
    echo "$NOW" > "$PULL_STAMP"
fi

shift  # drop 'audit'
exec "$REAL_BIN" audit --no-fetch --stale --db "$ADVISORY_DB_DIR" "$@"
